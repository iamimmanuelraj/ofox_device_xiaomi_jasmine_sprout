cc_library {
    name: "libgptutils.qti",
    export_include_dirs: ["."],
    recovery_available: true,
    shared_libs: [
        "libcutils",
        "liblog",
        "libz",
    ],
    // jasmine (OrangeFox): eMMC, no kernel source in the recovery build -> bionic uapi headers
    cflags: ["-D_BSG_FRAMEWORK_KERNEL_HEADERS"],
    srcs: [
        "gpt-utils.cpp",
        "recovery-ufs-bsg.cpp",
    ],
    vendor: true,
}
