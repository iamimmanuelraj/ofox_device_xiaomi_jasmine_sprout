# OrangeFox init for jasmine_sprout (SDM660)

import /init.recovery.qcom_decrypt.rc

on init
    setprop sys.usb.configfs 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on boot
    # adb as early as possible (logs even if the GUI or decryption stalls)
    setprop sys.usb.config adb

    # Notification LED (white, on the "red" channel like the ROM's lights HAL):
    # lit while a charger is connected, by the kernel's power-supply trigger.
    # OrangeFox's DataManager::Leds() writes brightness 0 on most page changes, which
    # detaches the trigger; it does nothing when leds/green is missing, so hide the
    # (unconnected) green channel.
    mount tmpfs none /sys/class/leds/green ro size=0
    write /sys/class/leds/red/trigger battery-charging-or-full

    start vendor.qti.vibrator

    # Torch LEDs for the OrangeFox flashlight
    chmod 0666 /sys/class/leds/led:torch_0/brightness
    chmod 0666 /sys/class/leds/led:switch_0/brightness

# QTI AIDL vibrator HAL (qti-haptics input device), used by OrangeFox for haptics
service vendor.qti.vibrator /system/bin/vendor.qti.hardware.vibrator.service
    user system
    group system input
    disabled
    seclabel u:r:recovery:s0
